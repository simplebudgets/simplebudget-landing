---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import budgetLogo from '../assets/simplebudget.png';
---

<Base title="simpleBudget — Budgeting Made Simple" description="Plan your month, track your spending, and see where your money goes. A simple, mobile-first budget app.">
  <section class="product-hero">
    <Image src={budgetLogo} alt="simpleBudget logo" width={72} height={72} class="product-logo" />
    <h1>Budgeting that gets<br />out of your way</h1>
    <p class="hero-sub">
      Plan your month, track your spending, and see where your money goes — all in one clean interface. No spreadsheets, no complexity.
    </p>
    <div class="hero-cta">
      <a href="https://budget.simplesuite.dev" class="btn btn-primary btn-large">Open simple<strong>Budget</strong></a>
      <a href="https://github.com/simplesuite/simplebudget" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-large">View on GitHub</a>
    </div>
  </section>

  <section class="features">
    <h2>Everything you need, nothing you don't</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">📋</div>
        <h3>Multiple Budgets</h3>
        <p>Create separate budgets for different purposes — monthly household, vacation fund, side project. Switch between them instantly.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📁</div>
        <h3>Sections & Categories</h3>
        <p>Organize your budget with sections (groups like "Housing", "Food") and categories (line items like "Rent", "Groceries"). Structure it however makes sense to you.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">💸</div>
        <h3>Transaction Tracking</h3>
        <p>Log expenses and income as they happen. Assign transactions to categories and watch your remaining balances update in real time.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">✂️</div>
        <h3>Split Transactions</h3>
        <p>One purchase, multiple categories. Split a grocery run between "Food" and "Household" without logging two separate transactions.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">👥</div>
        <h3>Shared Budgets</h3>
        <p>Share a budget with your spouse, partner, or roommate via QR code. Everyone sees the same data in real time via Supabase sync.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📊</div>
        <h3>Analytics</h3>
        <p>Pie charts break down your income and expenses by category. See exactly where your money goes at a glance.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🔄</div>
        <h3>Copy Budget Outlines</h3>
        <p>Start a new month by copying your existing structure — sections, categories, and amounts carry forward so you don't rebuild from scratch.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📤</div>
        <h3>CSV Export</h3>
        <p>Export your budget data to CSV anytime. Your data belongs to you — take it wherever you want.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📱</div>
        <h3>PWA — Works Everywhere</h3>
        <p>Install on your phone's home screen for a native app feel. No app store required. Works on iOS, Android, and desktop.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🌓</div>
        <h3>Dark & Light Themes</h3>
        <p>Switch between dark and light mode. Budget at midnight or over morning coffee — it looks great either way.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>Offline Capable</h3>
        <p>Service worker caching means the app loads instantly, even on spotty connections. Auto-update prompts keep you current.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🔒</div>
        <h3>Private & Secure</h3>
        <p>Row-level security in Supabase means only you (and people you share with) can access your budget data. We never sell your info.</p>
      </div>
    </div>
  </section>

  <section class="how-it-works">
    <h2>Up and running in 2 minutes</h2>
    <div class="steps">
      <div class="step">
        <span class="step-number">1</span>
        <h3>Create your budget</h3>
        <p>Name it and start adding sections and categories. Use income and expense groups to plan your month.</p>
      </div>
      <div class="step">
        <span class="step-number">2</span>
        <h3>Set your amounts</h3>
        <p>Assign dollar amounts to each category. See your planned income vs. expenses at a glance.</p>
      </div>
      <div class="step">
        <span class="step-number">3</span>
        <h3>Track as you spend</h3>
        <p>Add transactions throughout the month. Watch your remaining balances update in real time.</p>
      </div>
      <div class="step">
        <span class="step-number">4</span>
        <h3>Review & repeat</h3>
        <p>Check analytics to see where money went, copy the budget outline to next month, and keep improving.</p>
      </div>
    </div>
  </section>

  <section class="tech-section">
    <h2>Built with modern tools</h2>
    <div class="tech-grid">
      <span class="tech-badge">React 19</span>
      <span class="tech-badge">TypeScript</span>
      <span class="tech-badge">Vite</span>
      <span class="tech-badge">MUI 7</span>
      <span class="tech-badge">Zustand</span>
      <span class="tech-badge">Supabase</span>
      <span class="tech-badge">PWA</span>
    </div>
    <p class="tech-note">Open source under AGPL-3.0. Self-host it or use the hosted version.</p>
  </section>

  <section class="cta-section">
    <h2>Ready to take control of your money?</h2>
    <p>Free to start, no credit card required.</p>
    <div class="cta-buttons">
      <a href="https://budget.simplesuite.dev" class="btn btn-primary btn-large">Open simple<strong>Budget</strong></a>
      <a href="/pricing" class="btn btn-secondary btn-large">See Pricing</a>
    </div>
  </section>
</Base>

<style>
  .product-hero {
    text-align: center;
    padding: 5rem 0 4rem;
  }

  .product-hero .product-logo {
    border-radius: 16px;
    margin-bottom: 1.5rem;
  }

  .product-hero h1 {
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    margin-top: 1.25rem;
    font-size: 1.2rem;
    color: var(--color-text-muted);
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    margin-top: 2.5rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .features {
    padding: 4rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .features h2 {
    font-size: 2rem;
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius);
    padding: 1.75rem;
    transition: border-color 0.2s;
  }

  .feature-card:hover {
    border-color: rgba(255, 255, 255, 0.12);
  }

  .feature-icon {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .feature-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .feature-card p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .how-it-works {
    padding: 4rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .how-it-works h2 {
    font-size: 2rem;
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }

  .step {
    position: relative;
    padding-left: 3.5rem;
  }

  .step-number {
    position: absolute;
    left: 0;
    top: 0;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
  }

  .step h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .step p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .tech-section {
    padding: 4rem 0;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .tech-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .tech-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .tech-badge {
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .tech-note {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .cta-section {
    text-align: center;
    padding: 5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 2rem;
  }

  .cta-section h2 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .cta-section p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
