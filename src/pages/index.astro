---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import budgetLogo from "../assets/simplebudget.png";
import trackerLogo from "../assets/simpleTracker.png";
---

<Base title="simpleSuite — Simple Tools for Everyday Life">
  <section class="hero">
    <h1>Simple tools for<br />everyday life</h1>
    <p class="hero-sub">
      A growing suite of apps designed to do one thing well — and stay out of
      your way. Manage your money. Organize your tasks. More to come.
    </p>
    <div class="hero-cta">
      <a href="#products" class="btn btn-gradient btn-large">Explore Products</a
      >
      <a href="/pricing" class="btn btn-secondary btn-large">See Pricing</a>
    </div>
  </section>

  <section class="products" id="products">
    <h2>The Suite</h2>
    <div class="product-grid">
      <div class="product-card">
        <Image
          src={budgetLogo}
          alt="simpleBudget logo"
          width={48}
          height={48}
          class="product-card-logo"
        />
        <h3>simple<strong>Budget</strong></h3>
        <p class="product-tagline">Budgeting made simple</p>
        <p>
          Plan your month, track your spending, and see where your money goes —
          all in one clean interface. No spreadsheets, no complexity.
        </p>
        <ul class="product-highlights">
          <li>Plan income & expenses by category</li>
          <li>Track transactions in real time</li>
          <li>Share budgets with a partner</li>
          <li>Visual spending analytics</li>
          <li>Works offline as a PWA</li>
        </ul>
        <div class="product-card-actions">
          <a href="https://budget.simplesuite.dev" class="btn btn-primary"
            >Open App →</a
          >
          <a href="/simplebudget" class="btn btn-secondary">Read More</a>
        </div>
      </div>

      <div class="product-card tracker">
        <Image
          src={trackerLogo}
          alt="simpleTracker logo"
          width={48}
          height={48}
          class="product-card-logo"
        />
        <h3>simple<strong>Tracker</strong></h3>
        <p class="product-tagline">Notes, tasks & projects made simple</p>
        <p>
          Manage notes with Markdown, track tasks with subtasks and due dates,
          and organize everything into projects. Offline-first and mobile-ready.
        </p>
        <ul class="product-highlights">
          <li>Markdown notes with live preview</li>
          <li>Tasks with subtasks, due dates & recurrence</li>
          <li>Organize into projects</li>
          <li>Share notes & projects with others</li>
          <li>Full offline support as a PWA</li>
        </ul>
        <div class="product-card-actions">
          <a href="https://tracker.simplesuite.dev" class="btn btn-tracker"
            >Open App →</a
          >
          <a href="/simpletracker" class="btn btn-secondary">Read More</a>
        </div>
      </div>
    </div>
  </section>

  <section class="values">
    <h2>What every simpleSuite app shares</h2>
    <div class="values-grid">
      <div class="value-card">
        <div class="value-icon">🎯</div>
        <h3>One job, done well</h3>
        <p>
          Each app solves one problem without feature creep. If it doesn't earn
          its place, it doesn't ship.
        </p>
      </div>
      <div class="value-card">
        <div class="value-icon">📱</div>
        <h3>Works everywhere</h3>
        <p>
          Install as a PWA on any device or use in any browser. Your data is
          always with you — even offline.
        </p>
      </div>
      <div class="value-card">
        <div class="value-icon">🔒</div>
        <h3>Private & secure</h3>
        <p>
          Your data is never sold or shared. We make money from subscriptions,
          not from you.
        </p>
      </div>
      <div class="value-card">
        <div class="value-icon">⚡</div>
        <h3>Fast & lightweight</h3>
        <p>
          No bloat. Each app loads fast, runs smooth, and respects your time.
        </p>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <h2>Ready to simplify?</h2>
    <p>
      Pick a tool and get started in under 2 minutes. Free plans available for
      everything.
    </p>
    <div class="cta-buttons">
      <a href="https://budget.simplesuite.dev" class="btn btn-primary btn-large"
        >Try simple<strong>Budget</strong></a
      >
      <a
        href="https://tracker.simplesuite.dev"
        class="btn btn-tracker btn-large">Try simple<strong>Tracker</strong></a
      >
    </div>
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 6rem 0 4rem;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    margin-top: 1.25rem;
    font-size: 1.2rem;
    color: var(--color-text-muted);
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    margin-top: 2.5rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .products {
    padding: 4rem 0;
  }

  .products h2 {
    font-size: 2rem;
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
  }

  .product-card {
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
  }

  .product-card-logo {
    border-radius: 12px;
    margin-bottom: 1rem;
  }

  .product-card h3 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
    font-weight: 400;
  }

  .product-card h3 strong {
    font-weight: 700;
  }

  .product-tagline {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .product-card > p:not(.product-tagline) {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .product-highlights {
    list-style: none;
    margin-bottom: 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .product-highlights li {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .product-highlights li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .product-card .btn {
    text-align: center;
  }

  .product-card-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: auto;
  }

  .btn-tracker {
    background: var(--color-tracker);
    color: #000;
  }

  .btn-gradient {
    background: linear-gradient(
      135deg,
      var(--color-primary),
      var(--color-tracker)
    );
    color: #fff;
  }

  .btn-gradient:hover {
    background: linear-gradient(
      135deg,
      var(--color-primary-hover),
      var(--color-tracker-hover)
    );
    color: #fff;
  }

  .btn-tracker:hover {
    background: var(--color-tracker-hover);
    color: #000;
  }

  .product-card.tracker .product-tagline {
    color: var(--color-tracker);
  }

  .product-card.tracker .product-highlights li::before {
    color: var(--color-tracker);
  }

  .values {
    padding: 4rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .values h2 {
    font-size: 2rem;
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .value-card {
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius);
    padding: 1.75rem;
    transition: border-color 0.2s;
  }

  .value-card:hover {
    border-color: rgba(255, 255, 255, 0.12);
  }

  .value-icon {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .value-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .value-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .cta-section {
    text-align: center;
    padding: 5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 2rem;
  }

  .cta-section h2 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .cta-section p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
