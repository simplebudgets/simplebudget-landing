---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import budgetLogo from '../../assets/simplebudget.png';
import trackerLogo from '../../assets/simpleTracker.png';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map(guide => ({
    params: { id: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<Base title={`${guide.data.title} — simpleSuite`} description={guide.data.description}>
  <article class="guide">
    <a href="/guides" class="back-link">← All Guides</a>
    <div class="guide-product-badge">
      {guide.data.product === 'simplebudget' && (
        <Image src={budgetLogo} alt="" width={20} height={20} class="guide-product-logo" />
        <span class="guide-product-name budget" set:html="simple<strong>Budget</strong>"></span>
      )}
      {guide.data.product === 'simpletracker' && (
        <Image src={trackerLogo} alt="" width={20} height={20} class="guide-product-logo" />
        <span class="guide-product-name tracker" set:html="simple<strong>Tracker</strong>"></span>
      )}
      {guide.data.product === 'general' && (
        <span class="guide-product-emoji">📚</span>
        <span class="guide-product-name">General</span>
      )}
    </div>
    <h1>{guide.data.title}</h1>
    <div class="guide-content">
      <Content />
    </div>
  </article>
</Base>

<style>
  .guide {
    max-width: 700px;
    padding: 3rem 0 5rem;
  }

  .back-link {
    display: inline-block;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .guide-product-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .guide-product-logo {
    border-radius: 4px;
  }

  .guide-product-emoji {
    font-size: 1rem;
  }

  .guide-product-name {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .guide-product-name strong {
    font-weight: 700;
  }

  .guide-product-name.budget {
    color: var(--color-primary);
  }

  .guide-product-name.tracker {
    color: var(--color-tracker);
  }

  .guide h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 2rem;
  }

  .guide-content {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .guide-content :global(h2) {
    color: var(--color-text);
    font-size: 1.35rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .guide-content :global(h3) {
    color: var(--color-text);
    font-size: 1.1rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .guide-content :global(p) {
    margin-bottom: 1rem;
  }

  .guide-content :global(ol),
  .guide-content :global(ul) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .guide-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .guide-content :global(strong) {
    color: var(--color-text);
  }

  .guide-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .guide-content :global(a:hover) {
    color: #5a93b3;
  }

  .guide-content :global(code) {
    background: rgba(255, 255, 255, 0.06);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .guide-content :global(.guide-screenshot) {
    display: block;
    margin: 1.5rem auto;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    max-width: 300px;
    width: 100%;
    height: auto;
  }

  .guide-content :global(.guide-screenshot-row) {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin: 1.5rem 0;
  }

  .guide-content :global(.guide-screenshot-row .guide-screenshot) {
    margin: 0;
  }
</style>
