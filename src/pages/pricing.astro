---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import budgetLogo from "../assets/simplebudget.png";
import trackerLogo from "../assets/simpleTracker.png";
---

<Base
  title="Pricing — simpleSuite"
  description="Simple pricing for simple tools. Start free, upgrade when you're ready."
>
  <section class="pricing-hero">
    <h1>Simple pricing, no surprises</h1>
    <p>Every app starts free. Upgrade when you need more.</p>
  </section>

  <section class="product-pricing">
    <h2 class="product-pricing-title">
      <Image
        src={budgetLogo}
        alt="simpleBudget logo"
        width={32}
        height={32}
        class="pricing-logo"
      /><span>simple<strong>Budget</strong></span>
    </h2>
    <div class="pricing-grid">
      <div class="plan-card">
        <div class="plan-header">
          <h3>Free</h3>
          <div class="plan-price">
            <span class="price">$0</span>
            <span class="period">/month</span>
          </div>
        </div>
        <ul class="plan-features">
          <li>1 budget</li>
          <li>Unlimited sections & categories</li>
          <li>Unlimited transactions</li>
          <li>Share budgets with others</li>
          <li>Copy budget outlines month-to-month</li>
          <li>Basic analytics</li>
          <li>PWA — install on any device</li>
        </ul>
        <a
          href="https://budget.simplesuite.dev"
          class="btn btn-secondary btn-large plan-cta">Get Started</a
        >
      </div>

      <div class="plan-card featured">
        <div class="plan-badge">Most Popular</div>
        <div class="plan-header">
          <h3>Pro</h3>
          <div class="plan-price">
            <span class="price">$4</span>
            <span class="period">/month</span>
          </div>
        </div>
        <ul class="plan-features">
          <li>Unlimited budgets</li>
          <li>Export to CSV</li>
          <li>Advanced analytics</li>
          <li>Priority support</li>
        </ul>
        <a
          href="https://budget.simplesuite.dev"
          class="btn btn-primary btn-large plan-cta">Start Free Trial</a
        >
      </div>
    </div>
  </section>

  <section class="product-pricing tracker-section">
    <h2 class="product-pricing-title">
      <Image
        src={trackerLogo}
        alt="simpleTracker logo"
        width={32}
        height={32}
        class="pricing-logo"
      /><span>simple<strong>Tracker</strong></span>
    </h2>
    <div class="pricing-grid">
      <div class="plan-card">
        <div class="plan-header">
          <h3>Free</h3>
          <div class="plan-price">
            <span class="price">$0</span>
            <span class="period">/month</span>
          </div>
        </div>
        <ul class="plan-features">
          <li>Unlimited notes & tasks</li>
          <li>Up to 3 projects</li>
          <li>Subtasks & due dates</li>
          <li>Recurring tasks</li>
          <li>Markdown editing</li>
          <li>Full offline support</li>
          <li>PWA — install on any device</li>
        </ul>
        <a
          href="https://tracker.simplesuite.dev"
          class="btn btn-secondary btn-large plan-cta">Get Started</a
        >
      </div>

      <div class="plan-card featured tracker-featured">
        <div class="plan-badge tracker-badge">Pro</div>
        <div class="plan-header">
          <h3>Pro</h3>
          <div class="plan-price">
            <span class="price">$4</span>
            <span class="period">/month</span>
          </div>
        </div>
        <ul class="plan-features">
          <li>Unlimited projects</li>
          <li>Share notes & projects</li>
          <li>Export to CSV</li>
          <li>Priority support</li>
        </ul>
        <a
          href="https://tracker.simplesuite.dev"
          class="btn btn-tracker btn-large plan-cta">Start Free Trial</a
        >
      </div>
    </div>
  </section>

  <section class="faq">
    <h2>Questions?</h2>
    <div class="faq-grid">
      <div class="faq-item">
        <h4>Can I cancel anytime?</h4>
        <p>
          Yes. Cancel from your settings page and you'll keep Pro access until
          the end of your billing period.
        </p>
      </div>
      <div class="faq-item">
        <h4>Is there a free trial?</h4>
        <p>
          Pro comes with a 14-day free trial on every app. No credit card
          required to start.
        </p>
      </div>
      <div class="faq-item">
        <h4>What happens to my data if I downgrade?</h4>
        <p>
          Your data is never deleted. You'll keep read access to everything but
          some features may be limited on the free plan.
        </p>
      </div>
      <div class="faq-item">
        <h4>Do you offer annual billing?</h4>
        <p>
          Yes — annual plans save 25%. You can switch to annual from your
          settings at any time.
        </p>
      </div>
      <div class="faq-item">
        <h4>Is there a bundle discount?</h4>
        <p>
          Not yet — each app is priced and billed independently. We may offer
          bundle pricing as the suite grows.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .pricing-hero {
    text-align: center;
    padding: 5rem 0 3rem;
  }

  .pricing-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
  }

  .pricing-hero p {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
    font-size: 1.15rem;
  }

  .product-pricing {
    padding: 2rem 0 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .product-pricing h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .product-pricing-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 400;
  }

  .product-pricing-title strong {
    font-weight: 700;
  }

  .pricing-logo {
    border-radius: 8px;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 750px;
  }

  .plan-card {
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .plan-card.featured {
    border-color: var(--color-primary);
    box-shadow: 0 0 40px rgba(76, 128, 158, 0.15);
  }

  .plan-badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 1rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .plan-header h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .price {
    font-size: 3rem;
    font-weight: 700;
  }

  .period {
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .plan-features {
    list-style: none;
    margin: 2rem 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .plan-features li {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    padding-left: 1.5rem;
    position: relative;
  }

  .plan-features li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  .plan-cta {
    text-align: center;
    display: block;
  }

  .btn-tracker {
    background: var(--color-tracker);
    color: #000;
  }

  .btn-tracker:hover {
    background: var(--color-tracker-hover);
    color: #000;
  }

  .plan-card.tracker-featured {
    border-color: var(--color-tracker);
    box-shadow: 0 0 40px rgba(215, 154, 0, 0.15);
  }

  .tracker-badge {
    background: var(--color-tracker) !important;
    color: #000 !important;
  }

  .tracker-section .plan-features li::before {
    color: var(--color-tracker);
  }

  .faq {
    padding: 4rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .faq h2 {
    font-size: 1.75rem;
    text-align: center;
    margin-bottom: 2rem;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .faq-item {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .faq-item h4 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .faq-item p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
