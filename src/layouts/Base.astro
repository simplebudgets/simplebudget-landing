---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import budgetLogo from "../assets/simplebudget.png";
import trackerLogo from "../assets/simpleTracker.png";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Simple, beautiful tools to manage your money and your tasks. simpleBudget and simpleTracker — part of the simpleSuite family.",
  ogImage = "/android-chrome-192x192.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "simpleSuite",
  url: "https://simplesuite.dev",
  logo: "https://simplesuite.dev/android-chrome-192x192.png",
  description:
    "Simple, beautiful tools to manage your money and your tasks. simpleBudget and simpleTracker — part of the simpleSuite family.",
  sameAs: ["https://github.com/simplesuite"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content="simpleSuite" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo"
          ><Image
            src={logo}
            alt="simpleSuite logo"
            width={32}
            height={32}
          /><span>simple<strong>Suite</strong></span></a
        >
        <button
          class="mobile-menu-toggle"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <div class="nav-links">
          <div class="nav-dropdown">
            <button
              class="nav-dropdown-trigger"
              aria-expanded="false"
              aria-haspopup="true"
            >
              Products <svg
                width="10"
                height="6"
                viewBox="0 0 10 6"
                fill="currentColor"
                aria-hidden="true"><path d="M1 1l4 4 4-4"></path></svg
              >
            </button>
            <div class="nav-dropdown-menu" role="menu">
              <a href="/simplebudget" role="menuitem" class="dropdown-item">
                <Image
                  src={budgetLogo}
                  alt=""
                  width={24}
                  height={24}
                  class="dropdown-logo"
                />
                <div>
                  <span class="product-name">simple<strong>Budget</strong></span
                  >
                  <span>Budgeting made simple</span>
                </div>
              </a>
              <a href="/simpletracker" role="menuitem" class="dropdown-item">
                <Image
                  src={trackerLogo}
                  alt=""
                  width={24}
                  height={24}
                  class="dropdown-logo"
                />
                <div>
                  <span class="product-name"
                    >simple<strong>Tracker</strong></span
                  >
                  <span>Notes, tasks & projects made simple</span>
                </div>
              </a>
            </div>
          </div>
          <a href="/pricing">Pricing</a>
          <a href="/guides">Guides</a>
          <a href="/about">About</a>
          <a
            href="https://github.com/simplesuite"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-github"
            aria-label="GitHub"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              ><path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"
              ></path></svg
            >
          </a>
        </div>
        <div class="mobile-menu" aria-hidden="true">
          <a href="/simplebudget">simple<strong>Budget</strong></a>
          <a href="/simpletracker">simple<strong>Tracker</strong></a>
          <a href="/pricing">Pricing</a>
          <a href="/guides">Guides</a>
          <a href="/about">About</a>
          <a
            href="https://github.com/simplesuite"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="logo"
            ><Image
              src={logo}
              alt="simpleSuite logo"
              width={28}
              height={28}
            /><span>simple<strong>Suite</strong></span></a
          >
          <p>Simple tools for everyday life.</p>
        </div>
        <div class="footer-col">
          <h4>Products</h4>
          <a href="/simplebudget">simple<strong>Budget</strong></a>
          <a href="/simpletracker">simple<strong>Tracker</strong></a>
        </div>
        <div class="footer-col">
          <h4>Resources</h4>
          <a href="/guides">Guides</a>
          <a href="/pricing">Pricing</a>
          <a href="/about">About</a>
        </div>
        <div class="footer-col">
          <h4>Legal</h4>
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms of Service</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>
          &copy; {new Date().getFullYear()} simpleSuite. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #4c809e;
    --color-primary-hover: #5a93b3;
    --color-tracker: #d79a00;
    --color-tracker-hover: #e5ad1a;
    --color-secondary: #d6a058;
    --color-bg: #0f1117;
    --color-surface: #1a1d27;
    --color-text: #e8e8e8;
    --color-text-muted: #9ca3af;
    --max-width: 1100px;
    --radius: 12px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15, 17, 23, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .logo {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo img {
    border-radius: 6px;
  }

  .logo strong {
    color: var(--color-text);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links > a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .nav-links > a:hover {
    color: var(--color-text);
  }

  .nav-github {
    display: flex;
    align-items: center;
  }

  /* Dropdown */
  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-trigger {
    background: none;
    border: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.2s;
  }

  .nav-dropdown-trigger:hover {
    color: var(--color-text);
  }

  .nav-dropdown-trigger svg {
    transition: transform 0.2s;
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    padding: 0.5rem;
    min-width: 250px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.15s,
      transform 0.15s;
    transform: translateX(-50%) translateY(-4px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .nav-dropdown-menu::before {
    content: "";
    position: absolute;
    top: -0.75rem;
    left: 0;
    right: 0;
    height: 0.75rem;
  }

  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .nav-dropdown:hover .nav-dropdown-trigger svg {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    transition: background 0.15s;
  }

  .nav-dropdown-menu a:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-dropdown-menu a strong {
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .product-name strong {
    font-weight: 700;
  }

  .dropdown-logo {
    border-radius: 6px;
    flex-shrink: 0;
  }

  .nav-dropdown-menu a span {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .nav-dropdown-menu a span.product-name {
    font-size: 0.95rem;
    color: var(--color-text);
    font-weight: 400;
    white-space: nowrap;
  }

  .btn {
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.9rem;
    transition:
      background 0.2s,
      transform 0.1s;
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn-primary {
    background: var(--color-primary);
    color: #fff;
  }

  .btn-primary:hover {
    background: #5a93b3;
    color: #fff;
  }

  .btn-tracker {
    background: var(--color-tracker);
    color: #000;
  }

  .btn-tracker:hover {
    background: var(--color-tracker-hover);
    color: #000;
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-text);
  }

  .btn-secondary:hover {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .btn-large {
    padding: 0.85rem 2rem;
    font-size: 1.05rem;
  }

  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  footer {
    margin-top: 6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 3rem 1.5rem 2rem;
    max-width: var(--max-width);
    margin-left: auto;
    margin-right: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2rem;
  }

  .footer-brand p {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--color-text);
  }

  .footer-bottom {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  /* Mobile menu toggle */
  .mobile-menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.25rem;
    transition: color 0.2s;
  }

  .mobile-menu-toggle:hover {
    color: var(--color-text);
  }

  /* Mobile menu panel */
  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    position: fixed;
    top: 57px;
    left: 0;
    right: 0;
    background: var(--color-surface);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1rem 1.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    z-index: 99;
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-menu a {
    color: var(--color-text-muted);
    padding: 0.75rem 0;
    font-size: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: color 0.2s;
  }

  .mobile-menu a:last-child {
    border-bottom: none;
  }

  .mobile-menu a:hover {
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .nav-links {
      gap: 1rem;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .nav-links {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const toggle = document.querySelector(".mobile-menu-toggle");
  const menu = document.querySelector(".mobile-menu");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("open");
      toggle.setAttribute("aria-expanded", String(isOpen));
      menu.setAttribute("aria-hidden", String(!isOpen));
    });
  }
</script>
